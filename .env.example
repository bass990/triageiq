# Copy this file to .env and fill in your own values.
# The real .env is gitignored; this template is committed.

# Anthropic API key for the model calls. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ---- optional: models -------------------------------------------------------
# TRIAGEIQ_MODEL=claude-sonnet-5                  # synthesizer (final ESI + action plan)
# TRIAGEIQ_MODEL_FAST=claude-haiku-4-5-20251001   # specialists, report chat

# ---- optional: pipeline shape (eval-driven) ---------------------------------
# TRIAGEIQ_PIPELINE=lean        # lean = Symptom specialist + Synthesizer (default); full = 4 specialists
# TRIAGEIQ_FALLBACK=1           # rule-based ESI (degraded, LOW confidence) when the model API is unavailable
# TRIAGEIQ_SANITIZE=1           # tokenise the patient name and scan intake text for injected instructions

# ---- optional: limits -------------------------------------------------------
# TRIAGEIQ_TOKEN_CEILING=60000  # abort a run past this many tokens (fallback takes over)
# TRIAGEIQ_CALL_CEILING=12
# TRIAGEIQ_TIMEOUT_S=45

# ---- optional: deployment ---------------------------------------------------
# TRIAGEIQ_DEMO=0               # 1 = replay demo/sample_trace.json; free text and chat disabled
# TRIAGEIQ_CORS_ORIGINS=http://localhost:3001
# TRIAGEIQ_AUDIT_LOG=logs/audit.jsonl
